{
    "type": "object",
    "additionalProperties": false,
    "required": ["suggestions"],
    "properties": {
        "suggestions": {
            "type": "array",
            "maxItems": 5,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "question", "draft"],
                "properties": {
                    "id": { "type": "string", "maxLength": 10 },
                    "question": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                    },
                    "draft": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                }
            }
        }
    }
}

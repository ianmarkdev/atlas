{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "answer",
        "claims",
        "clarification_questions"
    ],
    "properties": {
        "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
        },
        "claims": {
            "type": "array",
            "maxItems": 40,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "text",
                    "classification",
                    "evidence_ids"
                ],
                "properties": {
                    "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                    },
                    "classification": {
                        "type": "string",
                        "enum": [
                            "verified",
                            "inferred",
                            "proposed",
                            "hypothetical"
                        ]
                    },
                    "evidence_ids": {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
                            "type": "string",
                            "maxLength": 10
                        }
                    }
                }
            }
        },
        "clarification_questions": {
            "type": "array",
            "maxItems": 3,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "question",
                    "why"
                ],
                "properties": {
                    "question": {
                        "type": "string",
                        "maxLength": 500
                    },
                    "why": {
                        "type": "string",
                        "maxLength": 500
                    }
                }
            }
        }
    }
}
